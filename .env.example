APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=
SALES_EMAIL=
SITE_URL=

# SerpApi — Media Location Insights (server-side only, never commit)
SERPAPI_API_KEY=
SERPAPI_MONTHLY_LIMIT=250
SERPAPI_TIMEOUT=20
SERPAPI_CACHE_DAYS=90

# Media Location Insights — nearby-places provider: geoapify | serpapi
INSIGHTS_PLACES_PROVIDER=geoapify
INSIGHTS_LOG_RETENTION_DAYS=180

# Geoapify Places (server-side only, never commit the key)
GEOAPIFY_API_KEY=
GEOAPIFY_RADIUS=1000
GEOAPIFY_LIMIT=60
GEOAPIFY_DAILY_CREDIT_LIMIT=2500
GEOAPIFY_CACHE_DAYS=90
GEOAPIFY_TIMEOUT=15
GEOAPIFY_BATCH_SIZE=500
GEOAPIFY_REQUESTS_PER_SECOND=4

# TomTom Search (Media Location Insights) — set INSIGHTS_PLACES_PROVIDER=tomtom to use it
TOMTOM_API_KEY=
TOMTOM_RADIUS=1000
TOMTOM_LIMIT=60
TOMTOM_DAILY_REQUEST_LIMIT=2000
TOMTOM_CACHE_DAYS=90
TOMTOM_TIMEOUT=15
# TomTom Traffic Flow (refresh:hoarding-traffic). TOMTOM_CACHE_DAYS above is also
# the days between traffic refreshes per hoarding (15 recommended).
TOMTOM_BATCH_SIZE=100
TOMTOM_REQUEST_DELAY_MS=250
TOMTOM_TRAFFIC_DAILY_LIMIT=2000
TOMTOM_TRAFFIC_RETRY_HOURS=24

# RoadStar Audience API (roadstar:sync → roadstar_audience_data). Basic auth;
# real username/password go in .env only — never commit them. RoadStar's docs
# state no rate limit, so the limits below are ours.
ROADSTAR_BASE_URL=http://dev.roadstar.live:5000
ROADSTAR_USERNAME=
ROADSTAR_PASSWORD=
ROADSTAR_TIMEOUT=60
ROADSTAR_CONNECT_TIMEOUT=10
ROADSTAR_BATCH_SIZE=20
ROADSTAR_REQUEST_DELAY_MS=1000
ROADSTAR_REQUESTS_PER_MINUTE=30
ROADSTAR_MAX_PER_RUN=2000
ROADSTAR_QUEUE=roadstar
# Scheduled / bulk sync stays off until single-media sync is confirmed.
ROADSTAR_BULK_SYNC_ENABLED=false
ROADSTAR_REFRESH_DAYS=15
ROADSTAR_RETRY_HOURS=24
ROADSTAR_PERIOD_DAYS=30
ROADSTAR_PERIOD_END_OFFSET_DAYS=1
# Fixed period instead of the rolling window. The dev server only has data
# for 2024-03-01 → 2024-03-31; leave both empty in production.
ROADSTAR_PERIOD_START=
ROADSTAR_PERIOD_END=
ROADSTAR_SITE_PREFIX=BI/
ROADSTAR_SCHEDULE_AT=11:00
ROADSTAR_SCHEDULE_WEEKDAYS_ONLY=true
