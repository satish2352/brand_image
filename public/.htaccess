# The bulk media import uploads an Excel sheet plus an images ZIP in one POST.
# On LiteSpeed the server's own "Connection Timeout" ends that request long
# before PHP is done receiving it, and answers with LiteSpeed's "Request
# Timeout" page — PHP's max_execution_time never gets a say. Connection Timeout
# lives in the LiteSpeed admin config, out of reach from cPanel, so we opt this
# app out of it instead:
#   noconntimeout — do not cut the request off at Connection Timeout
#   noabort       — keep running if the browser gives up first
# Guarded by mod_rewrite rather than by <IfModule Litespeed>: LiteSpeed's own
# module name is spelled inconsistently across its docs, and a name that does
# not match turns the block off without saying so. LiteSpeed emulates
# mod_rewrite, so this guard holds there, and on Apache the two environment
# variables are simply set and never read.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule .* - [E=noabort:1,E=noconntimeout:1]
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
